# SAATHI AI INTERVIEW COACH - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your environment.

# Server Environment Mode (development | production)
ENVIRONMENT=development

# Authentication & Security
# WARNING: Must be at least 32 random characters in production mode!
SECRET_KEY=saathi-super-secret-temp-key-change-in-production-2026

# Allowed Origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# MongoDB Configuration (Authentication & User Accounts)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_interview_bot_db

# Supabase Configuration (Interview Persistence & Snapshots)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# GitHub Intelligence Integration
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# LinkedIn Intelligence Integration (Proxycurl API)
PROXYCURL_API_KEY=your_proxycurl_api_key_here

# Ollama LLM Engine Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
